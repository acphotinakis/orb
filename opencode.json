{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "local": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp Local",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1",
                "timeout": false
            },
            "models": {
                "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF": {
                    "name": "Qwen3 Coder 30B GGUF",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 65536,
                        "output": 4096
                    }
                }
            }
        }
    },
    "model": "local/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF",
    "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "skill": "allow"
    }
}